<process xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne" name="NextTaskCalculation" implementationType="http://www.omg.org/spec/CMMN/ProcessType/Unspecified">
    <input id="index__SEFl" name="index" typeRef="number"/>
    <output id="_uJl8_out1" name="out1"/>
    <extensionElements mustUnderstand="false">
        <cafienne:implementation xmlns:cafienne="org.cafienne" class="org.cafienne.processtask.implementation.calculation.CalculationDefinition">
            <step output="out1" xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL">
                <input source="index"/>
                <expression>1</expression>
                <condition>index != 5</condition>
            </step>
            <step output="out1" xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL">
                <input source="index"/>
                <expression>2</expression>
                <condition>index == 5</condition>
            </step>
        </cafienne:implementation>
    </extensionElements>
</process>
