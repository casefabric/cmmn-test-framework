<process xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne" name="FixedOutputArray" implementationType="http://www.omg.org/spec/CMMN/ProcessType/Unspecified">
    <output id="TaskOutput__cfih" name="TaskOutput"/>
    <extensionElements mustUnderstand="false">
        <cafienne:implementation xmlns:cafienne="org.cafienne" class="org.cafienne.processtask.implementation.calculation.CalculationDefinition" async="true">
            <step output="first" xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL">
                <expression>map("metadata", map("description", "irrelevant"))</expression>
            </step>
            <step output="second" xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL">
                <expression>map("metadata", map("description", "relevant"), "taskitems", list(map("item", 1), map("item", 2)))</expression>
            </step>
            <step output="TaskOutput" xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL">
                <input source="first"/>
                <input source="second"/>
                <expression>{first, second}</expression>
            </step>
        </cafienne:implementation>
    </extensionElements>
</process>
